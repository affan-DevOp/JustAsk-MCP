{
  "name": "justask-workspace",
  "version": "0.0.2",
  "description": "Build agent-ready tools with one shared TypeScript core for MCP, CLI, and Skills.",
  "author": "Affan Mushtaque <https://github.com/affan-DevOp>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/affan-DevOp/JustAsk-MCP.git"
  },
  "homepage": "https://github.com/affan-DevOp/JustAsk-MCP#readme",
  "bugs": {
    "url": "https://github.com/affan-DevOp/JustAsk-MCP/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:core": "bun run --filter @amz-dev/justask-core build",
    "build:cli": "bun run --filter @amz-dev/justask build",
    "build:local-mcp": "bun run --filter @amz-dev/justask-mcp build",
    "build": "bun run build:core && bun run build:cli && bun run build:local-mcp",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "dev:local-mcp": "bun run packages/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun run apps/remote-mcp/src/index.ts",
    "release:pack:core": "bun run --filter @amz-dev/justask-core pack:dry",
    "release:pack:cli": "bun run --filter @amz-dev/justask pack:dry",
    "release:pack:local-mcp": "bun run --filter @amz-dev/justask-mcp pack:dry",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clerk/backend": "^3.8.2",
    "@clerk/mcp-tools": "^0.5.0",
    "@types/node": "^25.9.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  }
}
